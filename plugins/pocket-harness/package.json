{
  "name": "pocket-harness",
  "version": "0.3.3",
  "description": "Pocket Harness：DSH 手机端。手机上接着用电脑里的同一份 DSH —— 会话、项目、目标、队列状态一致；语音与桌宠可选。",
  "type": "module",
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "panel.mjs",
    "lan.mjs",
    "public.mjs",
    "guardPath.mjs",
    "selftest.mjs",
    "public/",
    "tts/",
    "asr/",
    "token.mjs",
    "relay.mjs"
  ],
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/pocket-harness.git",
    "directory": "plugins/pocket-harness"
  },
  "homepage": "https://github.com/regrevia/pocket-harness#readme",
  "bugs": {
    "url": "https://github.com/regrevia/pocket-harness/issues"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mobile",
    "android",
    "voice",
    "pet",
    "deepseek-harness"
  ]
}
